{
  "name": "payeebook",
  "private": true,
  "version": "1.0.0",
  "description": "Free, local-first accounts for Social Security representative payees, guardians and conservators.",
  "license": "GPL-3.0-or-later",
  "author": "Joel Stain Lobo",
  "homepage": "https://github.com/lobojoel2003/Payeebook",
  "repository": {
    "type": "git",
    "url": "https://github.com/lobojoel2003/Payeebook.git"
  },
  "bugs": {
    "url": "https://github.com/lobojoel2003/Payeebook/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "vendor": "node scripts/vendor-assets.mjs",
    "predev": "npm run vendor",
    "dev": "vite",
    "prebuild": "npm run vendor",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "templates:validate": "vitest run src/core/templates/library.test.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/render-icons.mjs && tauri icon src-tauri/icons/source.png",
    "version:sync": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs && git add src-tauri/Cargo.toml src-tauri/Cargo.lock src-tauri/tauri.conf.json",
    "release:notes": "node scripts/release-notes.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run templates:validate && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "idb-keyval": "^6.3.0",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.76.0",
    "papaparse": "^5.7.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "sql.js": "^1.17.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
